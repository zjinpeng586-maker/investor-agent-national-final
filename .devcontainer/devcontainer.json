{
  "name": "Financial Report QA (read-only deployment)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "containerEnv": {
    "FINANCIAL_DEPLOYMENT": "public",
    "FINANCIAL_WORKSPACE": "main"
  },
  "postCreateCommand": "python -m venv .venv && .venv/bin/python -m pip install -r requirements.txt && .venv/bin/python -m pip check",
  "postAttachCommand": {
    "server": ".venv/bin/python -m streamlit run app/main.py --server.address 0.0.0.0 --server.port 8501 --server.enableCORS true --server.enableXsrfProtection true"
  },
  "portsAttributes": {
    "8501": {
      "label": "Read-only deployment",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
